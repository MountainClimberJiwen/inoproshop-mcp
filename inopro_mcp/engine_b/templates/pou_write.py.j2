{% include "_prelude.py.j2" %}
try:
    proj = get_primary_project()
    app = find_application(proj)
    if app is None:
        raise Exception('工程里没有 Application，无法写 POU')
    step('find pou {{ pou_name }}')
    pou = find_child(app, {{ pou_name | pystr }})
    if pou is None:
        for folder in iter_children(app):
            pou = find_child(folder, {{ pou_name | pystr }})
            if pou is not None:
                break
    if pou is None:
        raise Exception('找不到 POU {{ pou_name }}（pou_write 不会自动创建，请先用 pou_create）')

    written = {}
    {% if declaration is not none %}
    step('replace declaration')
    pou.textual_declaration.replace({{ declaration | pystr }})
    written['declaration'] = True
    log('declaration written, %d chars' % len({{ declaration | pystr }}))
    {% endif %}
    {% if implementation is not none %}
    step('replace implementation')
    pou.textual_implementation.replace({{ implementation | pystr }})
    written['implementation'] = True
    log('implementation written, %d chars' % len({{ implementation | pystr }}))
    {% endif %}
    if not written:
        raise Exception('declaration 和 implementation 都未提供，无事可做')
    write_result({'ok': True, 'name': {{ pou_name | pystr }}, 'written': written})
except Exception as e:
    fail(e)
