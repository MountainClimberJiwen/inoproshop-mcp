{% include "_prelude.py.j2" %}
try:
    proj = get_primary_project()
    app = find_application(proj)
    if app is None:
        raise Exception('工程里没有 Application，无法读取 POU')
    step('find pou {{ pou_name }}')
    pou = find_child(app, {{ pou_name | pystr }})
    if pou is None:
        # 有的版本 POU 挂在 application 下的文件夹层级里，递归再找一层
        for folder in iter_children(app):
            pou = find_child(folder, {{ pou_name | pystr }})
            if pou is not None:
                break
    if pou is None:
        raise Exception('找不到 POU {{ pou_name }}，可用 pou_list 查看现有 POU')

    def read_doc(getter_name):
        try:
            doc = getattr(pou, getter_name)
        except Exception as e:
            return None, 'no attr ' + getter_name + ': ' + str(e)[:80]
        attr, v = probe_attr(doc, ['text', 'Text'])
        if attr:
            try:
                return str(v), attr
            except Exception:
                return None, 'unreadable via ' + attr
        return None, 'no text attr on ' + getter_name

    decl, decl_via = read_doc('textual_declaration')
    impl, impl_via = read_doc('textual_implementation')
    write_result({'ok': True, 'name': {{ pou_name | pystr }},
                  'declaration': decl, 'implementation': impl,
                  'via': {'declaration': decl_via, 'implementation': impl_via}})
except Exception as e:
    fail(e)
